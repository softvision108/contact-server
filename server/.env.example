MONGO_URI=mongodb://127.0.0.1:27017/contact-server
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=4200
WEB_PORT=4201
# Seed only: first password of the admin account (it is not changed on later seeds).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Seed only: provider list to import.
SEED_CONTACTS_FILE=../../C project main doc/Lin - Contacts/contacts.json
# Seed only: people export folder (one folder per country).
SEED_PEOPLE_DIR=../../C project main doc/Contact/Gmail and Phone/slotmaniax-users-by-country
# Seed only: licence-help companies.
SEED_LICENSE_FILE=../../C project main doc/License/licenses.json
# Seed only: casino/slots/poker streamers scraped from Kick and Twitch.
SEED_STREAMERS_FILE=../../C project main doc/Streamers/streamers.json
# Email sending through Resend (Send email on the list pages). The daily limit is set in the app (Settings > Mail, default 100).
RESEND_API_KEY=
# Sender as "Name <address>" on a domain verified in Resend; empty = onboarding@resend.dev (reaches only the Resend account owner)
RESEND_FROM=
MAIL_REPLY_TO=
MAIL_DELAY_MS=3000
# true = do everything except really send (to try the flow)
MAIL_DRY_RUN=false
